#dotenv -f talos.env run gmake pi5

#gmake/gsed required for MacOS
SED="gsed"

#PCIe 3.0 (keep in sync with CONFIG_TXT in .github/workflows/build.yaml)
#Pi 5 board with a 5A PSU: add usb_max_current_enable=1 and dtparam=pciex1
#Add dtparam=rtc_bbat_vchg=3000000 only on boards with a rechargeable RTC battery
CONFIG_TXT="dtparam=pciex1_gen=3
"

#Required for Longhorn CSI (nfs-utils for RWX volumes)
EXTENSIONS="ghcr.io/siderolabs/iscsi-tools:v0.2.0 ghcr.io/siderolabs/util-linux-tools:2.41.2 ghcr.io/siderolabs/nfs-utils:v0.1.1"

#Artifacts must be pushed to a registry during build
# docker run -d -p 5000 --restart always --name local registry:3
REGISTRY=registry:5000
REGISTRY_USERNAME=talos-pi5
